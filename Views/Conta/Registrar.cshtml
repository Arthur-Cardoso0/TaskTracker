@{
    ViewData["Title"] = "Criar Conta";
}
<div class="row justify-content-center mt-5">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="card-title text-center mb-4">Criar Conta</h2>

                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2" })

                <form asp-controller="Conta" asp-action="Registrar" method="post">
                    <div class="mb-3">
                        <label class="form-label">Usuário</label>
                        <input type="text" name="username" class="form-control" placeholder="Digite seu nome" required autocomplete="off">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Senha</label>
                        <input type="password" name="password" class="form-control" placeholder="Crie uma senha" required>
                    </div>
                    <div class="mb-4">
                        <label class="form-label">Confirme sua senha</label>
                        <input type="password" name="confirmPassword" class="form-control" placeholder="Repita a senha" required>
                    </div>
                    <div class="d-grid mb-3">
                        <button class="btn btn-primary" type="submit">Cadastrar</button>
                    </div>
                    <div class="text-center">
                        <a class="text-decoration-none" asp-controller="Conta" asp-action="Login">Já tem uma conta? Faça login</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>