@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="mb-4 text-center">Acesso ao Sistema</h2>
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        <div asp-validation-summary="All"></div>
                    </div>
                }
                <form asp-controller="Conta" asp-action="Login" method="post">
                    <div class="mb-3">
                        <label class="form-label">Usuário</label>
                        <input type="text" name="username" class="form-control" placeholder="Digite seu Nome" required />
                    </div>
                    <div class="mb-4">
                        <label class="form-label">Senha</label>
                        <input type="password" name="password" class="form-control" placeholder="Digite sua Senha" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Entrar</button>
                </form>

                <div class="mt-3 text-center">
                    <a asp-controller="Conta" asp-action="Registrar">Cadastre-se</a>
                </div>
            </div>
        </div>
        <div class="text-center mt-3">
            <a asp-controller="Admin" asp-action="Login" class="text-muted small text-decoration-none">
                Área do administrador
            </a>
        </div>
    </div>
</div>