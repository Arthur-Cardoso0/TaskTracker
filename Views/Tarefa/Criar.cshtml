@model TaskTracker.Models.Tarefa
@{
    ViewData["Title"] = "Criar Tarefa";
}
@if (ViewBag.BoardId != null)
{
    <a asp-controller="Board"
       asp-action="Detalhes"
       asp-route-id="@ViewBag.BoardId"
       class="btn btn-secondary">Voltar</a>
}
else
{
    <a asp-controller="Board"
       asp-action="Index"
       class="btn btn-secondary">Voltar aos quadros</a>
}
<h2>Criar Nova Tarefa</h2>
<form asp-action="Criar" method="post">
     <input type="hidden"asp-for="BoardListId" />
    @await Html.PartialAsync("_TarefaForm", Model)
    <button type="submit" class="btn btn-primary">Criar Tarefa</button>
</form>
