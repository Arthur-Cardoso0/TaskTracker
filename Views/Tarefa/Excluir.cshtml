@model TaskTracker.Models.Tarefa
@{
    ViewData["Title"] = "Excluir Tarefa";
}

<h2>Excluir Tarefa</h2>
<div class="alert alert-danger" role="alert">
    <strong>Tem certeza que deseja excluir esta tarefa?</strong>
</div>

<div>
    <dl class="row">
        <dt class="col-sm-3">Título</dt>
        <dd class="col-sm-9">@Model.Titulo</dd>

        <dt class="col-sm-3">Descrição</dt>
        <dd class="col-sm-9">@Model.Descricao</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>

        <dt class="col-sm-3">Prazo</dt>
        <dd class="col-sm-9">@Model.Prazo.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-3">Criado em</dt>
        <dd class="col-sm-9">@Model.CriadaEm.ToString("dd/MM/yyyy HH:mm")</dd>
    </dl>

    <form asp-action="Excluir" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="btn btn-danger">Confirmar Exclusão</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>