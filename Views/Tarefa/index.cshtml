@model IEnumerable<TaskTracker.Models.Tarefa>
@using TaskTracker.Models
@{
    ViewData["Title"] = "Minhas Tarefas";
}

@functions 
{
    public string FormatarStatus(StatusTarefa status)
    {
        return status switch
        {
            StatusTarefa.EmAndamento => "Em Andamento",
            StatusTarefa.Pendente => "Pendente",
            StatusTarefa.Concluida => "Concluída",
            _ => status.ToString()
        };
    }
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Minhas Tarefas</h2>
    <a asp-action="Criar" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Nova Tarefa
    </a>
</div>

<div class="card mb-4 shadow-sm border-0">
    <div class="card-body bg-light rounded">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label text-muted small fw-bold text-uppercase">Buscar texto</label>
                <input type="text" name="buscar" class="form-control" placeholder="Título ou descrição..." value="@ViewBag.FiltroBusca" />
            </div>      
            <div class="col-md-3">
                <label class="form-label text-muted small fw-bold text-uppercase">Status</label>
                <select name="statusFiltro" class="form-select" asp-items="Html.GetEnumSelectList<StatusTarefa>()">
                    <option value="">Todos os Status</option>
                </select>
            </div>  
            <div class="col-md-3">
                <label class="form-label text-muted small fw-bold text-uppercase">Prioridade</label>
                <select name="prioridadeFiltro" class="form-select" asp-items="Html.GetEnumSelectList<Prioridade>()">
                    <option value="">Todas as Prioridades</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">Filtrar</button>
                <a asp-action="Index" class="btn btn-outline-secondary w-100">Limpar</a>
            </div>
        </form>
    </div>
</div>

<div class="table-responsive shadow-sm rounded">
    <table class="table table-hover align-middle mb-0 bg-white">
        <thead class="table-light">
            <tr>
                <th>Título da Tarefa</th>
                <th>Descrição</th>
                <th>Status</th>
                <th>Prioridade</th>
                <th>Prazo</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="5" class="text-center text-muted py-4">Nenhuma tarefa encontrada.</td></tr>
            }
            else
            {
                @foreach (var tarefa in Model)
                {
                    <tr>
                        <td>
                            <strong class="d-block text-dark">@tarefa.Titulo</strong>
                            @if (tarefa.Categoria != null)
                            {
                                <span class="badge bg-secondary mt-1">@tarefa.Categoria.Nome</span>
                            }
                        </td>
                        <td><p class="d-block text-dark">@tarefa.Descricao</p></td>
                        <td>
                            @if (tarefa.Status == StatusTarefa.Concluida) { <span class="text-success fw-bold"><i class="bi bi-check-circle"></i> Concluída</span> }
                            else { <span>@FormatarStatus(tarefa.Status)</span> }
                        </td>
                        <td>
                            @if (tarefa.Prioridade == Prioridade.Alta) { <span class="badge bg-danger">Alta</span> }
                            else if (tarefa.Prioridade == Prioridade.Media) { <span class="badge bg-warning text-dark">Média</span> }
                            else { <span class="badge bg-info text-dark">Baixa</span> }
                        </td>
                        <td>@tarefa.Prazo.ToString("dd/MM/yyyy")</td>
                        <td>
                            <div class="d-flex gap-2">
                                <a asp-action="Detalhes" asp-route-id="@tarefa.Id" class="btn btn-sm btn-info text-white">Ver</a>
                                <a asp-action="Editar" asp-route-id="@tarefa.Id" class="btn btn-sm btn-warning">Editar</a>
                                <a asp-action="Excluir" asp-route-id="@tarefa.Id" class="btn btn-sm btn-danger">Excluir</a>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>