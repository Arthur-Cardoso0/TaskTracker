@model IEnumerable<TaskTracker.Models.Tarefa>

@{
    ViewData["Title"] = "Gerenciamento de Tarefas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Minhas Tarefas</h2>
    <a asp-action="Criar" class="btn btn-primary">
        + Nova Tarefa
    </a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Título</th>
                    <th>Descrição</th>
                    <th>Status</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var tarefa in Model)
                    {
                        <tr>
                            <td><strong>@tarefa.Titulo</strong></td>
                            <td class="text-muted">@tarefa.Descricao</td>
                            <td>
                                @if (tarefa.Status.ToString() == "Concluida")
                                {
                                    <span class="badge bg-success">Concluída</span>
                                }
                                else if (tarefa.Status.ToString() == "EmAndamento")
                                {
                                    <span class="badge bg-warning text-dark">Em andamento</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Pendente</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Editar" asp-route-id="@tarefa.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                                <a asp-action="Detalhes" asp-route-id="@tarefa.Id" class="btn btn-sm btn-outline-secondary">Detalhes</a>
                                <a asp-action="Excluir" asp-route-id="@tarefa.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">
                            Nenhuma tarefa cadastrada no momento. Clique em "Nova Tarefa" para começar!
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>