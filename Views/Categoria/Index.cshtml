@model IEnumerable<TaskTracker.Models.Categoria>

@{
    ViewData["Title"] = "Minhas categorias";
}

<h1>Minhas categorias</h1>

<a asp-action="Criar" class="btn btn-primary mb-3">
    Nova categoria
</a>

@if (!Model.Any())
{
    <p>Você ainda não cadastrou categorias.</p>
}
else
{
    <ul class="list-group">
        @foreach (var categoria in Model)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center gap-3">
                <span>@categoria.Nome</span>

                <div class="d-flex gap-2">
                    <a asp-action="Editar" asp-route-id="@categoria.Id" class="btn btn-sm btn-outline-primary">
                        Editar
                    </a>

                    <a asp-action="Excluir" asp-route-id="@categoria.Id" class="btn btn-sm btn-outline-danger">
                        Excluir
                    </a>
                </div>
            </li>
        }
    </ul>
}