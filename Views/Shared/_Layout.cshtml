@using System.Security.Claims
<!DOCTYPE html>
<html lang="pt-br">
    <head>
        <meta charset="uft-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>@ViewData["Title"] - TaskTracker</title>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    </head>
    <body>
        <header>
            <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-4">
                <div class="container">
                    <a class="navbar-brand" asp-controller="Home" asp-action="Index">TaskTracker</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navMenu">
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item">
                                <a class="navbar-brand" asp-controller="Home" asp-action="Index">Início</a>
                            </li>
                            @if(User.Identity.IsAuthenticated)
                            {
                                @if(User.HasClaim(ClaimTypes.Role, "Admin"))
                                {
                                    <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="Index">Gerenciar Tarefas</a>
                                </li>
                                }
                                else{
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Tarefa" asp-action="Index">Minhas Tarefas</a>
                                </li>
                                }
                            }
                        </ul>
                    </div>
                </div>
            </nav>
        </header>

        <div class="container">
            <main class="pb-3" role="main">
                @RenderBody()
            </main>
        </div>

        <footer class="footer text-center border-top mt-5">
            <div class="container">
                &copy; @DateTime.Now.Year - TaskTracker
            </div>
        </footer>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>
</html>