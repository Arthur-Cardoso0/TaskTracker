@using System.Security.Claims
<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - TaskTracker Admin</title>
    <script>
            (function () {
                var stored = localStorage.getItem("tasktracker-theme");
                var theme = stored === "light" || stored === "dark"
                    ? stored
                    : (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
                document.documentElement.setAttribute("data-bs-theme", theme);
            })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg admin-navbar mb-4 shadow-sm">
            <div class="container">
                <!-- Logo e Título -->
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Admin" asp-action="Index">
                    <span class="admin-badge">ADMIN</span>
                    <span class="fw-semibold">Painel Administrativo</span>
                </a>

                @if ((bool?)ViewData["ShowAdminNav"] ?? true)
                {
                    <!-- Ações à direita no mobile (Botão de Tema + Menu Hamburger) -->
                    <div class="d-flex align-items-center gap-2 d-lg-none">
                        <button type="button" class="theme-toggle btn btn-link text-decoration-none p-1"
                                aria-pressed="false" aria-label="Alternar tema" title="Alternar tema">
                            <i class="bi bi-moon-stars-fill"></i>
                            <i class="bi bi-sun-fill"></i>
                        </button>
                        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse"
                                data-bs-target="#adminNavbarMenu" aria-controls="adminNavbarMenu" aria-expanded="false"
                                aria-label="Navegação">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                    </div>

                    <!-- Conteúdo Colapsável da Navbar -->
                    <div class="collapse navbar-collapse" id="adminNavbarMenu">
                        <!-- Links Centrais/Esquerdos -->
                        <ul class="navbar-nav me-auto ms-lg-3 mb-2 mb-lg-0 gap-lg-2">
                            <li class="nav-item">
                                <a class="nav-link px-3 rounded" asp-controller="Admin" asp-action="Index">Usuários</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link px-3 rounded" asp-controller="Admin"
                                   asp-action="GerenciarCategorias">Categorias</a>
                            </li>
                        </ul>

                        <!-- Ações do Usuário e Botão de Tema (Desktop) -->
                        <div class="d-none d-lg-flex align-items-center gap-3">
                            <button type="button" class="theme-toggle btn btn-link text-decoration-none p-1"
                                    aria-pressed="false" aria-label="Alternar tema" title="Alternar tema">
                                <i class="bi bi-moon-stars-fill"></i>
                                <i class="bi bi-sun-fill"></i>
                            </button>
                            <span class="admin-user fw-medium">@User.FindFirst(ClaimTypes.Name)?.Value</span>
                            <form asp-controller="Admin" asp-action="Logout" method="post" class="m-0">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Sair</button>
                            </form>
                        </div>

                        <!-- Ações do Usuário (Mobile Dropdown/Lista) -->
                        <div class="d-lg-none border-top pt-3 mt-2 d-flex flex-column gap-2">
                            <div class="d-flex justify-content-between align-items-center px-2">
                                <span class="admin-user fw-medium text-muted">Logado como:
                                    <strong>@User.FindFirst(ClaimTypes.Name)?.Value</strong></span>
                                </div>
                                <form asp-controller="Admin" asp-action="Logout" method="post" class="m-0 px-2 pb-2">
                                    <button type="submit" class="btn btn-sm btn-outline-danger w-100">Sair da Conta</button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </nav>
        </header>
        <div class="container">
            <main class="pb-5" role="main">
                @RenderBody()
            </main>
        </div>

        <footer class="footer text-center border-top mt-5">
            <div class="container">
                &copy; @DateTime.Now.Year - TaskTracker Admin
            </div>
        </footer>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/theme.js" asp-append-version="true"></script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>

</html>