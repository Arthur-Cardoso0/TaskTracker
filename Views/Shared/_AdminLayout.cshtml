@using System.Security.Claims
<!DOCTYPE html>
<html lang="pt-br">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>@ViewData["Title"] - TaskTracker Admin</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    </head>
    <body>
        <header>
            <nav class="navbar admin-navbar mb-4">
                <div class="container d-flex justify-content-between align-items-center">
                    <a class="navbar-brand" asp-controller="Admin" asp-action="Index">
                        <span class="admin-badge">ADMIN</span> Painel Administrativo
                    </a>
                    @if ((bool?)ViewData["ShowAdminNav"] ?? true)
                    {
                        <div class="d-flex align-items-center gap-3">
                            <span class="admin-user">@User.FindFirst(ClaimTypes.Name)?.Value</span>
                            <form asp-controller="Admin" asp-action="Logout" method="post" class="m-0">
                                <button type="submit" class="btn btn-sm btn-outline-light">Sair</button>
                            </form>
                        </div>
                    }
                </div>
            </nav>
        </header>
git add Controllers/AdminController.cs
git commit -m "Adiciona funcionalidade de criar novo administrador"
        <div class="container">
            <main class="pb-5" role="main">
                @RenderBody()
            </main>
        </div>

        <footer class="footer text-center border-top mt-5">
            <div class="container">
                &copy; @DateTime.Now.Year - TaskTracker Admin
            </div>
        </footer>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>
</html>