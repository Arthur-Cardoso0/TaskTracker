@{
    ViewData["Title"] = "Login Administrativo";
    Layout = "_AdminLayout";
    ViewData["ShowAdminNav"] = false;
}

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h3 class="text-center mb-1">Acesso Restrito</h3>
                <p class="text-center text-muted small mb-4">Área exclusiva para administradores</p>

                <form asp-controller="Admin" asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label">Usuário</label>
                        <input type="text" name="username" class="form-control" required />
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Senha</label>
                        <input type="password" name="senha" class="form-control" required />
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Entrar</button>
                    <div class="text-center mt-3">
                        <a asp-controller="Conta" asp-action="Index" class="text-muted small text-decoration-none">Área do Usuario</a>
                    </div>    
                </form>
            </div>
        </div>
    </div>
</div>