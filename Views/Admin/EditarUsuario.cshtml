@model TaskTracker.Models.Usuario
@{
    ViewData["Title"] = "Editar Usuário";
    Layout = "_AdminLayout";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <h3 class="card-title mb-4">Editar Usuário</h3>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                <form asp-action="EditarUsuario" asp-route-id="@Model.Id" method="post">
                    <div class="mb-3">
                        <label class="form-label">Nome do Usuário</label>
                        <input asp-for="Nome" class="form-control" required />
                    </div>
                    <div class="mb-4">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" type="email" class="form-control" required />
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary w-100">Salvar Alterações</button>
                        <a asp-action="Index" class="btn btn-outline-secondary w-100">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>