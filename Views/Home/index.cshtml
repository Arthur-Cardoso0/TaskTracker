@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Página Inicial";
    bool logado = User.Identity != null && User.Identity.IsAuthenticated;
}

<section class="hero-section">
    <div class="hero-blob hero-blob-1"></div>
    <div class="hero-blob hero-blob-2"></div>
    <div class="row align-items-center g-5 position-relative">
        <div class="col-lg-6">
            <span class="hero-eyebrow">
                <i class="bi bi-check2-circle"></i> Gerencie suas tarefas
            </span>
            @if (logado)
            {
                <h1 class="hero-title mt-3">Olá, @User.Identity!.Name!</h1>
                <p class="hero-subtitle">Você está logado. Continue organizando sua rotina de onde parou.</p>
                <div class="d-flex flex-wrap gap-2 mt-4">
                    <a asp-controller="Tarefa" asp-action="Index" class="btn btn-primary btn-lg">
                        <i class="bi bi-list-task me-1"></i> Ver Minhas Tarefas
                    </a>
                    <form asp-controller="Conta" asp-action="Logout" method="post" class="m-0">
                        <button type="submit" class="btn btn-outline-secondary btn-lg">Deslogar</button>
                    </form>
                </div>
            }
            else
            {
                <h1 class="hero-title mt-3">Organize sua rotina com o TaskTracker</h1>
                <p class="hero-subtitle">Crie, acompanhe e conclua suas tarefas em um só lugar. Simples, rápido e sempre à mão.</p>
                <div class="d-flex flex-wrap gap-2 mt-4">
                    <a asp-controller="Conta" asp-action="Login" class="btn btn-primary btn-lg">Começar agora</a>
                    <a asp-controller="Conta" asp-action="Registrar" class="btn btn-outline-secondary btn-lg">Criar Conta</a>
                </div>
            }
        </div>
        <div class="col-lg-6">
            <div class="hero-preview-card">
                <div class="hero-preview-header">
                    <span class="hero-preview-dot"></span>
                    <span class="hero-preview-dot"></span>
                    <span class="hero-preview-dot"></span>
                    <span class="ms-2 small text-muted">Minhas Tarefas</span>
                </div>
                <div class="hero-preview-row">
                    <i class="bi bi-circle text-secondary"></i>
                    <span>Planejar sprint da semana</span>
                    <span class="badge bg-secondary ms-auto">Pendente</span>
                </div>
                <div class="hero-preview-row">
                    <i class="bi bi-arrow-repeat text-warning"></i>
                    <span>Revisar relatório mensal</span>
                    <span class="badge bg-warning text-dark ms-auto">Em andamento</span>
                </div>
                <div class="hero-preview-row">
                    <i class="bi bi-check-circle-fill text-success"></i>
                    <span class="text-decoration-line-through text-muted">Configurar ambiente</span>
                    <span class="badge bg-success ms-auto">Concluída</span>
                </div>
            </div>
        </div>
    </div>
</section>
<section class="features-section">
    <div class="row g-4">
        <div class="col-md-4">
            <div class="feature-card">
                <div class="feature-icon">
                    <i class="bi bi-kanban-fill"></i>
                </div>
                <h5>Organize por status</h5>
                <p class="text-muted mb-0">Acompanhe o que está pendente, em andamento ou já concluído, tudo visualmente separado.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="feature-card">
                <div class="feature-icon">
                    <i class="bi bi-calendar-check-fill"></i>
                </div>
                <h5>Prazos em dia</h5>
                <p class="text-muted mb-0">Defina uma data para cada tarefa e nunca mais perca um prazo importante.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="feature-card">
                <div class="feature-icon">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <h5>Seus dados, sua conta</h5>
                <p class="text-muted mb-0">Login protegido e tarefas visíveis somente para você, com senha sempre criptografada.</p>
            </div>
        </div>
    </div>
</section>
