@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Pagina Inicial";
}
<div class="text-center mt-5">
    <h1 class="display-4 mb-4">Bem-vindo ao TasckTracker</h1>

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <div class="mb-3">
            <p>Olá,<strong>@User.Identity.Name!</strong></p>
            <p>Você está logado e pode acessar suas tarefas.</p>
        </div>
        <form asp-controller="Conta" asp-action="Logout" method="post">
            <button type="submit" class="btn btn-outline-danger">Deslogar</button>
        </form>       
    }
    else
    {
        <div class="mb-3">
            <p>Você não está logado. Por favor, faça login para realizar suas tarefas.</p>
        </div>
        <a asp-controller="Conta" asp-action="Login" class="btn btn-primary">Login</a>
    }
</div>